[Unit]
Description=SWitch remote microphone test processor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/sdy/previews/switch-voice-20261122/hardware/kiosk_audio_monitor
EnvironmentFile=/home/sdy/.config/switch-agent/agent.env
EnvironmentFile=/home/sdy/.config/switch-voice/device.env
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8
Environment=SWITCH_AUDIO_DENOISE=rnnoise
ExecStart=/home/sdy/previews/switch-voice-20261122/.venv/bin/python voice_remote_server.py
Restart=on-failure
RestartSec=3
UMask=0077
KillMode=control-group

[Install]
WantedBy=default.target
