# Copy to .env and configure locally. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol
OPENAI_TTS_MODEL=gpt-realtime-2.1-mini
OPENAI_TTS_VOICE=marin
# Local ESP32 STT/filter CLI (does not change the order agent model).
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_FILTER_MODEL=gpt-5.6-luna
# Optional. auto filter selects Jev when this is configured locally.
TYPESAFE_API_KEY=
